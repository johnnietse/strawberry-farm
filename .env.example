# G.O.S. Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_USER=researcher
POSTGRES_PASSWORD=REMOVED-DEFAULT-PASSWORD
POSTGRES_DB=strawberry_research
DATABASE_URL=postgresql://researcher:REMOVED-DEFAULT-PASSWORD@db/strawberry_research

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD=REMOVED-DEFAULT-PASSWORD

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Simulation Mode (set to 'real' for physical hardware, 'sim' for simulation)
GOS_MODE=sim

# Node Count (for simulation)
NODE_COUNT=40

# Logging Level
LOG_LEVEL=INFO

# API write access (LED settings, events, assistant). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Empty = the API is read-only. Enter the same token in the dashboard header.
GOS_API_TOKEN=
# Other web pages allowed to call the API from a browser, comma-separated, or * for any.
# The dashboard needs nothing here: it reaches the API through its own address (/api/).
GOS_CORS_ORIGINS=
# Assistant limits (0 = no rate limit)
ASSISTANT_MAX_CHARS=8000
ASSISTANT_RATE=30

# Time zone of the phytotron (dark period of the LED safety monitor) and the dark period
LED_TZ=America/Toronto
LED_DARK_START=22
LED_DARK_END=6

# Research assistant: local model in the ollama service, and optional Claude API key
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
ANTHROPIC_API_KEY=

# Network exposure. API (5000), dashboard (8080) and Grafana (3000) listen on every network the
# Pi joins; the database and MQTT only on the Pi itself unless opened here.
DB_BIND=127.0.0.1
MQTT_BIND=127.0.0.1
