# G.O.S. Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_USER=researcher
POSTGRES_PASSWORD=REMOVED-DEFAULT-PASSWORD
POSTGRES_DB=strawberry_research
DATABASE_URL=postgresql://researcher:REMOVED-DEFAULT-PASSWORD@db/strawberry_research

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD=REMOVED-DEFAULT-PASSWORD

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Simulation Mode (set to 'real' for physical hardware, 'sim' for simulation)
GOS_MODE=sim

# Node Count (for simulation)
NODE_COUNT=40

# Logging Level
LOG_LEVEL=INFO

# API write access (LED settings, events, assistant). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Empty = the API is read-only. Enter the same token in the dashboard header.
GOS_API_TOKEN=
# Origins allowed to call the API from a browser (the dashboard)
GOS_CORS_ORIGINS=http://localhost:8080
