menu "G.O.S. sensor node"

config GOS_NODE_INDEX
	int "Node index (phytotron position)"
	range 1 40
	default 1
	help
	  Sent in byte 1 of every research packet. Give each node its own value.

config GOS_UPLINK_PEER_ADDR
	string "IPv6 address the uplink is sent to"
	default "ff03::1"
	help
	  Default is the realm-local all-nodes multicast address, which reaches
	  every Thread device including the border router, so no gateway address
	  has to be known. Set a unicast address to send to one host only.

config GOS_UPLINK_PEER_PORT
	int "UDP port the uplink is sent to"
	default 5683

config GOS_UPLINK_KEY
	string "Uplink signing key (32 hex digits)"
	default ""
	help
	  128-bit HMAC-SHA256 key unique to this node. Set it in the git-ignored
	  credentials.conf; gateway/tools/provision_node.py generates it and
	  registers it with the gateway. With no valid key the node sends nothing.

config GOS_LED_HOLD_S
	int "Seconds to keep the last LED command without a new one"
	default 900
	help
	  The gateway sends an LED command in its reply to every packet (once a minute).
	  If no valid command arrives for this long (gateway or controller down, node out of
	  range), the node switches the LED board to the fallback levels below.

config GOS_LED_FALLBACK_BLUE
	int "Blue LED level (%) when no command has arrived for GOS_LED_HOLD_S"
	range 0 100
	default 0

config GOS_LED_FALLBACK_RED
	int "Red LED level (%) when no command has arrived for GOS_LED_HOLD_S"
	range 0 100
	default 0

config GOS_PAR_SENSOR
	bool "Quantum (PAR) sensor fitted on J6 (board rev 3.2)"
	default n
	help
	  Read a self-powered quantum sensor on J6 through AIN1 (P0.03) at every sample and
	  send it in the packet. Leave off on rev 3.1 boards and on nodes without a sensor:
	  the packet then reports PAR as not measured (0xFFFF) and the gateway estimates
	  daylight PAR from the lux reading as before.

config GOS_PAR_UMOL_PER_MV
	int "Quantum sensor calibration factor, umol m-2 s-1 per mV"
	depends on GOS_PAR_SENSOR
	range 1 10000
	default 100
	help
	  From the sensor's calibration certificate. Apogee SQ-500-SS nominal: 100
	  (0.01 mV per umol m-2 s-1, 0 to 40 mV). The SAADC reads J6 at gain 4, a 0.15 V
	  full scale, so sensors up to 150 mV fit.

config GOS_UPLINK_URI_PATH
	string "CoAP URI path for the uplink"
	default "telemetry"

endmenu

# Sleepy end device: ask the parent for queued messages every 30 s (the child timeout is
# 240 s). After each packet, uplink.c polls fast for about 2 s so the LED reply arrives
# within a second. A 1 s period would cost 20 to 40 uA; 30 s costs about 1 uA. Set here as a
# default (not in prj.conf) so the router build, which has no poll period, gets no warning.
config OPENTHREAD_POLL_PERIOD
	default 30000

source "Kconfig.zephyr"
