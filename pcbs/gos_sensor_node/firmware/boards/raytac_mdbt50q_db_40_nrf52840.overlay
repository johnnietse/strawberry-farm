/*
 * G.O.S. sensor node rev 3.1 (Raytac MDBT50Q-1MV2, nRF52840).
 *
 * Base board: raytac_mdbt50q_db_40/nrf52840, Raytac's demo board for the same module.
 * This overlay moves or removes everything on that board that does not exist here.
 * Pin map source: ../../HARDWARE.md (generated schematic, rev 3.1).
 *
 *   west build -b raytac_mdbt50q_db_40/nrf52840
 *
 * Zephyr applies this file automatically for that board because of its name.
 *
 * Taken unchanged from the base board:
 *   i2c0      SDA P0.26, SCL P0.27
 *   uicr      P0.18 is the reset pin (SW1, debug header)
 *   reg1      DC/DC mode, inductor is inside the module
 *   usbd      USB device on D+ / D-
 *   flash0    standard nRF52840 partition table
 */

/ {
	aliases {
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		pwm-led1 = &pwm_red;
	};

	pwmleds {
		/* J4 pin 3, PWM red, through 100R. Channel 0 (blue) is pwm_led0 below. */
		pwm_red: pwm_led_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "LED board red channel";
		};
	};

	/* VBAT through 2.2M / 2.2M with 100 nF at the pin (R10, R11, C7) */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <2200000>;
		full-ohms = <(2200000 + 2200000)>;
	};

	/* BQ24074 status outputs. Open drain with 100k pull-ups to 3.3 V on the board. */
	zephyr,user {
		pgood-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;	/* low = USB power good */
		chg-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;	/* low = charging */
	};
};

/* Demo-board parts that are not on this board */
/delete-node/ &led1;
/delete-node/ &led2;
/delete-node/ &button1;
/delete-node/ &button2;
/delete-node/ &button3;

/* D2 status LED, P0.17, on when low */
&led0 {
	gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
	label = "Status LED";
};

/* SW2 user button, P0.24 to GND, no external pull-up */
&button0 {
	gpios = <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	label = "User button";
};

/* J4 pin 2, PWM blue, through 100R. Drive is active high. */
&pwm_led0 {
	pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
	label = "LED board blue channel";
};

&pinctrl {
	/* Debug UART on TP5 / TP6. No RTS or CTS on this board. */
	gos_uart0_default: gos_uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 8)>;
			bias-pull-up;
		};
	};

	gos_uart0_sleep: gos_uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>,
				<NRF_PSEL(UART_RX, 0, 8)>;
			low-power-enable;
		};
	};

	/* Two channels only. P0.15 is the TSL2591 interrupt here, not a PWM output. */
	gos_pwm0_default: gos_pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,
				<NRF_PSEL(PWM_OUT1, 0, 14)>;
		};
	};

	/* Released in sleep: the 100k pull-downs at J4 hold the LED drivers off. */
	gos_pwm0_sleep: gos_pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,
				<NRF_PSEL(PWM_OUT1, 0, 14)>;
			low-power-enable;
		};
	};
};

&uart0 {
	pinctrl-0 = <&gos_uart0_default>;
	pinctrl-1 = <&gos_uart0_sleep>;
};

&pwm0 {
	pinctrl-0 = <&gos_pwm0_default>;
	pinctrl-1 = <&gos_pwm0_sleep>;
};

&i2c0 {
	clock-frequency = <100000>;

	sht40: sht4x@44 {
		compatible = "sensirion,sht4x";
		reg = <0x44>;
		repeatability = <2>;	/* high */
	};

	tsl2591: tsl2591@29 {
		compatible = "ams,tsl2591";
		reg = <0x29>;
		/* open drain, 100k pull-up to 3.3 V on the board */
		int-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	/* VBAT / 2 on P0.02. 0.6 V reference with gain 1/6 gives 3.6 V full scale. */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};
};

/* Enabled on the demo board, nothing connected here. Their pins are open or reused. */
&uart1 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

/* QSPI would claim P0.17 (status LED) and P0.19 to P0.23. No flash chip is fitted. */
&qspi {
	status = "disabled";
};
