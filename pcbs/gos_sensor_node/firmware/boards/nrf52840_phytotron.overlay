/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,bt-hci-uart = &uart0;
		zephyr,bt-mon-uart = &uart0;
	};

	aliases {
		led0 = &led_blue;
		led1 = &led_red;
		sw0 = &button_reset;
		sw1 = &button_dfu;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		spi0 = &spi0;
		spi1 = &spi1;
		uart0 = &uart0;
		uart1 = &uart1;
		pwm0 = &pwm0;
		pwm1 = &pwm1;
		adc0 = &adc;
		ieee802154 = &ieee802154;
	};

	/* Battery ADC Channels */
	adc: adc {
		compatible = "nordic,nrf-saadc";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		channel@0 {
			reg = <0>;
			zephyr,gain = "ADC_GAIN_1_6";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 3)>;
			zephyr,channel-id = <0>;
			zephyr,input-positive = <28>; /* P0.28 = AIN4 = VBATT_SENSE */
		};

		channel@1 {
			reg = <1>;
			zephyr,gain = "ADC_GAIN_1_6";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 3)>;
			zephyr,channel-id = <1>;
			zephyr,input-positive = <30>; /* P0.30 = AIN6 = VBUS_SENSE */
		};

		channel@2 {
			reg = <2>;
			zephyr,gain = "ADC_GAIN_1_6";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 3)>;
			zephyr,channel-id = <2>;
			zephyr,input-positive = <31>; /* P0.31 = AIN7 = VSYS_SENSE */
		};
	};

	/* Battery ADC Channels */
	battery_adc: battery_adc {
		compatible = "gos,battery-adc";
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>;
		io-channel-names = "vbatt", "vbus", "vsys";
		status = "okay";
	};

	/* External SPI Flash for LittleFS */
	ext_flash: ext_flash {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		label = "EXT_FLASH";
		jedec-id = [ef 40 15]; /* W25Q16JV */
		size = <2097152>; /* 2MB */
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
		status = "okay";
	};

	/* BQ24075 Charger */
	bq24075: bq24075@6b {
		compatible = "ti,bq24075";
		reg = <0x6b>;
		status = "okay";
		interrupt-parent = <&gpio0>;
		interrupts = <8 IRQ_TYPE_LEVEL_LOW>; /* PGOOD pin */
		ti,charge-current-ma = <742>;
		ti,input-current-limit-ma = <500>;
		ti,precharge-current-ma = <74>;
		ti,termination-current-ma = <74>;
		ti,voltage-regulation-mv = <4200>;
		ti,precharge-voltage-mv = <3000>;
		ti,recharge-threshold-mv = <100>;
		ti,watchdog-timeout-s = <7200>;
		ti,enable-charger;
		ti,enable-watchdog;
	};

	/* TPS62740 Buck Converter */
	tps62740: tps62740@0 {
		compatible = "ti,tps62740";
		reg = <0>;
		status = "okay";
		gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>, /* EN */
		        <&gpio0 16 GPIO_ACTIVE_HIGH>, /* VSEL0 */
		        <&gpio0 17 GPIO_ACTIVE_HIGH>; /* VSEL1 */
		interrupt-parent = <&gpio0>;
		interrupts = <18 IRQ_TYPE_LEVEL_LOW>; /* PG pin */
		ti,vsel0-gpio = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		ti,vsel1-gpio = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		ti,enable-gpio = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		ti,pg-gpio = <&gpio0 18 GPIO_ACTIVE_LOW>;
	};

	/* DW01A Protection IC */
	dw01a: dw01a@0 {
		compatible = "ablic,dw01a";
		status = "okay";
		interrupt-parent = <&gpio0>;
		interrupts = <19 IRQ_TYPE_LEVEL_LOW>, /* OD pin */
		             <20 IRQ_TYPE_LEVEL_LOW>; /* OC pin */
		gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>, /* OD output */
		        <&gpio0 22 GPIO_ACTIVE_HIGH>, /* OC output */
		        <&gpio0 23 GPIO_ACTIVE_HIGH>; /* CS input */
		ablic,ov-threshold-mv = <4250>;
		ablic,uv-threshold-mv = <2400>;
		ablic,oc-threshold-mv = <150>;
		ablic,oc-delay-ms = <100>;
	};

	/* FS8205A Dual N-MOSFET */
	fs8205a: fs8205a@0 {
		compatible = "fairchild,fs8205a";
		status = "okay";
		gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>, /* Q1 gate */
		        <&gpio0 25 GPIO_ACTIVE_HIGH>; /* Q2 gate */
	};

	/* SX1262 LoRa Transceiver */
	sx1262: sx1262@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;
		spi-cpol = <0>;
		spi-cpha = <0>;
		spi-hold-cs-delay = <10>;
		spi-cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>; /* NSS */
		interrupt-parent = <&gpio0>;
		interrupts = <11 IRQ_TYPE_LEVEL_HIGH>,  /* BUSY */
		             <12 IRQ_TYPE_LEVEL_HIGH>,  /* DIO1 */
		             <13 IRQ_TYPE_LEVEL_HIGH>,  /* DIO2 */
		             <13 IRQ_TYPE_LEVEL_HIGH>;  /* DIO3 */
		reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>; /* NRESET */
		semtech,tx-power = <22>;
		semtech,frequency = <915000000>;
		semtech,spreading-factor = <7>;
		semtech,bandwidth = <125000>;
		semtech,coding-rate = <1>;
		semtech,preamble-length = <8>;
		semtech,tx-power-dbm = <22>;
		semtech,rf-switch = <0>; /* RFO */
	};

	/* L76K GNSS Module */
	l76k: l76k@0 {
		compatible = "quectel,l76k";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cpol = <0>;
		spi-cpha = <0>;
		spi-hold-cs-delay = <10>;
		spi-cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio0>;
		interrupts = <16 IRQ_TYPE_LEVEL_HIGH>; /* PPS */
		reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
		quectel,baudrate = <9600>;
		quectel,pps-gpio = <&gpio0 16 GPIO_ACTIVE_HIGH>;
	};

	/* AL8860 LED Drivers */
	al8860_blue: al8860_blue@0 {
		compatible = "diodes,al8860";
		status = "okay";
		reg = <0>;
		gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>, /* EN/PWM */
		        <&gpio0 14 GPIO_ACTIVE_HIGH>; /* FB */
		diodes,current-ma = <300>;
		diodes,pwm-frequency = <100000>;
		diodes,bootstrap-capacitor = <10>;
	};

	al8860_red: al8860_red@0 {
		compatible = "diodes,al8860";
		status = "okay";
		reg = <0>;
		gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>, /* EN/PWM */
		        <&gpio0 19 GPIO_ACTIVE_HIGH>; /* FB */
		diodes,current-ma = <300>;
		diodes,pwm-frequency = <100000>;
		diodes,bootstrap-capacitor = <10>;
	};

	/* External SPI Flash for LittleFS */
	ext_flash: ext_flash {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		label = "EXT_FLASH";
		jedec-id = [ef 40 15]; /* W25Q16JV */
		size = <2097152>; /* 2MB */
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
		status = "okay";
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
	sda-pin = <26>;
	scl-pin = <27>;

	sht40: sht40@44 {
		compatible = "sensirion,sht40";
		reg = <0x44>;
		status = "okay";
		sensirion,heater = <0>;
	};

	tsl2591: tsl2591@29 {
		compatible = "ams,tsl2591";
		reg = <0x29>;
		status = "okay";
		interrupt-parent = <&gpio0>;
		interrupts = <15 IRQ_TYPE_LEVEL_LOW>; /* INT pin */
		ams,integration-time = <0x00>; /* 100ms */
		ams,gain = <0x10>; /* 25x */
	};

	/* External I2C Expansion Header */
	i2c_expansion: i2c_expansion@0 {
		compatible = "i2c-expansion";
		reg = <0>;
		status = "okay";
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>;
	sda-pin = <30>;
	scl-pin = <31>;
};

&spi0 {
	status = "okay";
	sck-pin = <10>;
	miso-pin = <11>;
	mosi-pin = <12>;
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
};

&spi1 {
	status = "okay";
	sck-pin = <16>;
	miso-pin = <17>;
	mosi-pin = <18>;
	cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	tx-pin = <6>;
	rx-pin = <8>;
	rts-pin = <7>;
	cts-pin = <5>;
};

&uart1 {
	status = "okay";
	current-speed = <9600>;
	tx-pin = <20>;
	rx-pin = <21>;
};

&pwm0 {
	status = "okay";
	ch0-pin = <13>; /* PWM_BLUE */
	ch1-pin = <14>; /* PWM_RED */
	ch2-pin = <18>; /* SWDIO */
	ch3-pin = <19>; /* SWCLK */
};

&adc {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&pwm0 {
	status = "okay";
	ch0-pin = <13>; /* PWM_BLUE */
	ch1-pin = <14>; /* PWM_RED */
};

&adc {
	status = "okay";
};

&wdt {
	status = "okay";
	timeout = <30000>;
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00010000>;
			read-only;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 0x00060000>;
		};

		slot1_partition: partition@70000 {
			label = "image-1";
			reg = <0x00070000 0x00060000>;
		};

		scratch_partition: partition@d0000 {
			label = "scratch";
			reg = <0x000d0000 0x00010000>;
		};

		storage_partition: partition@e0000 {
			label = "storage";
			reg = <0x000e0000 0x00020000>;
		};
	};
};

&nvs {
	partition = <&storage_partition>;
};