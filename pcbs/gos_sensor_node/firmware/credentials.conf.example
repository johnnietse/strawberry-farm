# Copy to credentials.conf (git-ignored). CMakeLists.txt adds it to the build
# when it exists. gateway/tools/provision_node.py prints a ready-made one.
#
# Thread network key, the same on every node and the border router. The value
# below is OpenThread's public example key: replace it.
CONFIG_OPENTHREAD_NETWORKKEY="00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff"
#
# This node's position (1 to 40) and its own signing key. Never reuse a key
# between nodes. Without a valid key the node does not send.
CONFIG_GOS_NODE_INDEX=1
CONFIG_GOS_UPLINK_KEY="REPLACE_WITH_32_HEX_DIGITS"
