{
  "uid": "gos-phytotron",
  "title": "G.O.S. phytotron",
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "gos"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Air temperature",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "gos-timescaledb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "postgres",
            "uid": "gos-timescaledb"
          },
          "rawSql": "SELECT time_bucket('5 minutes', time) AS time, node_id AS metric, avg(temp_c) AS value FROM raw_telemetry WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
